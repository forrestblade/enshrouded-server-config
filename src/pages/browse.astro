---
import Layout from '@/app/layouts/Layout.astro'
import ConfigCard from '@/entities/shared-config/ui/ConfigCard.astro'
import { env } from 'cloudflare:workers'
import { getDb } from '@/shared/db'
import { listConfigs, listTags } from '@/entities/shared-config/api/repo'
import { CONFIG_SORTS, type ConfigSort } from '@/entities/shared-config'

export const prerender = false

const PAGE_SIZE = 24

const url = Astro.url
const q = (url.searchParams.get('q') ?? '').trim()
const activeTag = (url.searchParams.get('tag') ?? '').trim()
const sortParam = url.searchParams.get('sort') ?? ''
const sort: ConfigSort = (CONFIG_SORTS as readonly string[]).includes(sortParam) ? sortParam as ConfigSort : 'recent'
const pageParam = Number.parseInt(url.searchParams.get('page') ?? '1', 10)
const page = Number.isFinite(pageParam) && pageParam >= 1 ? Math.min(pageParam, 400) : 1

// Fetch one extra row to know whether a next page exists without a count query.
const db = getDb(env.DB)
const [fetched, tags] = await Promise.all([
  listConfigs(db, {
    q: q || undefined,
    tag: activeTag || undefined,
    sort,
    limit: PAGE_SIZE + 1,
    offset: (page - 1) * PAGE_SIZE,
  }),
  listTags(db, 16),
])
const hasMore = fetched.length > PAGE_SIZE
const items = fetched.slice(0, PAGE_SIZE)

// Page is intentionally NOT carried over — changing search/tag/sort resets to
// page 1; only the pager links pass `page` explicitly.
function hrefWith (overrides: Record<string, string | undefined>): string {
  const merged: Record<string, string | undefined> = {
    q: q || undefined,
    tag: activeTag || undefined,
    sort: sort !== 'recent' ? sort : undefined,
    ...overrides,
  }
  const sp = new URLSearchParams()
  for (const [k, v] of Object.entries(merged)) if (v) sp.set(k, v)
  const s = sp.toString()
  return s ? `/browse?${s}` : '/browse'
}
---

<Layout title="Browse configs" description="Find and copy Enshrouded server configs shared by other players. Search by keyword or filter by tag.">
  <header class="browse-hero">
    <div class="browse-hero-media" aria-hidden="true"></div>
    <div class="browse-hero-inner container">
      <p class="eyebrow">Community gallery</p>
      <h1>Browse configs</h1>
      <form class="search" method="get" role="search">
        {sort !== 'recent' && <input type="hidden" name="sort" value={sort} />}
        {activeTag && <input type="hidden" name="tag" value={activeTag} />}
        <input type="search" name="q" value={q} placeholder="Search titles, servers, descriptions…" aria-label="Search configs" />
        <button class="btn btn-primary" type="submit">Search</button>
      </form>
    </div>
  </header>

  <section class="container browse-body">
    <div class="toolbar">
      <div class="sorts" role="tablist" aria-label="Sort">
        <a class={sort === 'recent' ? 'sort active' : 'sort'} href={hrefWith({ sort: undefined })}>Recent</a>
        <a class={sort === 'popular' ? 'sort active' : 'sort'} href={hrefWith({ sort: 'popular' })}>Popular</a>
      </div>
      <p class="count">{items.length} config{items.length === 1 ? '' : 's'}{q ? ` for “${q}”` : ''}{page > 1 ? ` · page ${page}` : ''}</p>
    </div>

    {tags.length > 0 && (
      <div class="tagbar">
        {activeTag && <a class="tag active" href={hrefWith({ tag: undefined })}>✕ {activeTag}</a>}
        {tags.filter((t) => t.slug !== activeTag).map((t) => (
          <a class="tag" href={hrefWith({ tag: t.slug })}>{t.name} <span>{t.count}</span></a>
        ))}
      </div>
    )}

    {items.length > 0
      ? (
        <div class="grid">
          {items.map((c) => <ConfigCard config={c} />)}
        </div>
      )
      : (
        <div class="empty">
          <p>No configs found{q ? ` for “${q}”` : ''}{activeTag ? ` tagged “${activeTag}”` : ''}.</p>
          <a class="btn btn-primary" href="/editor">Build one to share</a>
        </div>
      )}

    {(page > 1 || hasMore) && (
      <nav class="pager" aria-label="Pagination">
        {page > 1
          ? <a class="btn btn-ghost" rel="prev" href={hrefWith({ page: page > 2 ? String(page - 1) : undefined })}>← Previous</a>
          : <span aria-hidden="true"></span>}
        <span class="pager-page">Page {page}</span>
        {hasMore
          ? <a class="btn btn-ghost" rel="next" href={hrefWith({ page: String(page + 1) })}>Next →</a>
          : <span aria-hidden="true"></span>}
      </nav>
    )}
  </section>
</Layout>

<style>
  .browse-hero {
    position: relative;
    overflow: hidden;
    margin-left: calc(var(--rail-w) * -1);
    padding-left: var(--rail-w);
    border-bottom: 1px solid var(--border);
  }
  .browse-hero-media {
    position: absolute;
    inset: 0;
    background-image: url('/backgrounds/building.webp');
    background-image: image-set(url('/backgrounds/building.avif') type('image/avif'), url('/backgrounds/building.webp') type('image/webp'));
    background-size: cover;
    background-position: center 30%;
  }
  .browse-hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(13, 12, 11, 0.55), rgba(13, 12, 11, 0.8) 70%, var(--bg));
  }
  .browse-hero-inner {
    position: relative;
    padding-block: var(--space-10) var(--space-8);
  }
  .eyebrow {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
  }
  .browse-hero h1 {
    font-size: var(--fs-3xl);
    margin: var(--space-2) 0 var(--space-5);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
  }
  .search {
    display: flex;
    gap: var(--space-2);
    max-width: 560px;
  }
  .search input {
    flex: 1;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    border: 1px solid var(--border-2);
    border-radius: var(--radius);
    padding: 0.6rem 0.8rem;
    color: var(--text);
    font-size: var(--fs-base);
    backdrop-filter: blur(4px);
  }
  .search input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .browse-body {
    padding-block: var(--space-6) var(--space-10);
  }
  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .sorts {
    display: inline-flex;
    gap: var(--space-1);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 3px;
  }
  .sort {
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-decoration: none;
  }
  .sort:hover {
    color: var(--text);
    text-decoration: none;
  }
  .sort.active {
    background: var(--surface-3);
    color: var(--text);
  }
  .count {
    font-size: var(--fs-sm);
    color: var(--text-dim);
  }
  .tagbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--border-2);
    background: var(--surface);
    color: var(--text-muted);
    font-size: var(--fs-sm);
    text-decoration: none;
  }
  .tag span {
    color: var(--text-dim);
    font-size: var(--fs-xs);
  }
  .tag:hover {
    color: var(--text);
    border-color: var(--accent);
    text-decoration: none;
  }
  .tag.active {
    color: var(--primary-fg);
    background: var(--primary-bg);
    border-color: transparent;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
  }
  .empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-10) 0;
    color: var(--text-muted);
  }
  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .pager-page {
    font-size: var(--fs-sm);
    color: var(--text-dim);
  }
</style>
