---
import Layout from '@/app/layouts/Layout.astro'
import ConfigCard from '@/entities/shared-config/ui/ConfigCard.astro'
import { env } from 'cloudflare:workers'
import { getDb, user as userTable } from '@/shared/db'
import { listByUser } from '@/entities/shared-config/api/repo'
import { eq } from 'drizzle-orm'

export const prerender = false

// Usernames are stored normalized (lowercase) by the username plugin.
const handle = (Astro.params.username ?? '').toLowerCase()

const db = getDb(env.DB)
const rows = handle
  ? await db
      .select({
        username: userTable.username,
        displayUsername: userTable.displayUsername,
        image: userTable.image,
        createdAt: userTable.createdAt,
      })
      .from(userTable)
      .where(eq(userTable.username, handle))
      .limit(1)
  : []
const profile = rows[0]

if (!profile) {
  Astro.response.status = 404
}

const configs = profile?.username ? await listByUser(db, profile.username) : []
const totalLikes = configs.reduce((sum, c) => sum + c.likeCount, 0)

const displayName = profile ? (profile.displayUsername || profile.username) : handle
const joined = profile?.createdAt
  ? new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long' }).format(profile.createdAt)
  : null
const isSelf = Boolean(profile && Astro.locals.user?.username === profile.username)
---

{profile
  ? (
    <Layout title={`${displayName} — Enshrouded server config`} description={`Public Enshrouded server configs shared by ${displayName}.`}>
      <header class="cover">
        <div class="cover-media" aria-hidden="true"></div>
        <div class="cover-scrim" aria-hidden="true"></div>
      </header>

      <div class="container pf">
        <div class="pf-head">
          {profile.image
            ? <img class="avatar" src={profile.image} alt="" width="112" height="112" referrerpolicy="no-referrer" />
            : <span class="avatar avatar-fallback" aria-hidden="true">{String(displayName).charAt(0).toUpperCase()}</span>}
          <div class="pf-id">
            <h1>{displayName}</h1>
            <p class="handle">@{profile.username}</p>
            <div class="pf-stats">
              <span><strong>{configs.length}</strong> config{configs.length === 1 ? '' : 's'}</span>
              <span><strong>{totalLikes}</strong> like{totalLikes === 1 ? '' : 's'}</span>
              {joined && <span>Joined {joined}</span>}
            </div>
          </div>
          {isSelf && <a class="btn btn-ghost pf-edit" href="/account">Edit profile</a>}
        </div>

        <section class="pf-configs">
          <h2>Public configs</h2>
          {configs.length > 0
            ? (
              <div class="grid">
                {configs.map((c) => <ConfigCard config={c} />)}
              </div>
            )
            : (
              <div class="empty">
                <p>{isSelf ? 'You have not published any configs yet.' : `${displayName} has not published any configs yet.`}</p>
                {isSelf && <a class="btn btn-primary" href="/editor">Build one to share</a>}
              </div>
            )}
        </section>
      </div>
    </Layout>
  )
  : (
    <Layout title="Profile not found — Enshrouded server config" noindex>
      <section class="container notfound">
        <h1>Profile not found</h1>
        <p>No player with the username <strong>{handle}</strong> exists.</p>
        <a class="btn btn-ghost" href="/browse">Browse configs</a>
      </section>
    </Layout>
  )}

<style>
  .cover {
    position: relative;
    height: 230px;
    margin-left: calc(var(--rail-w) * -1);
    padding-left: var(--rail-w);
    overflow: hidden;
  }
  .cover-media {
    position: absolute;
    inset: 0;
    background-image: url('/backgrounds/combat.webp');
    background-image: image-set(url('/backgrounds/combat.avif') type('image/avif'), url('/backgrounds/combat.webp') type('image/webp'));
    background-size: cover;
    background-position: center 32%;
  }
  .cover-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(13, 12, 11, 0.35), rgba(13, 12, 11, 0.72) 70%, var(--bg));
  }

  .pf {
    position: relative;
  }
  .pf-head {
    display: flex;
    align-items: flex-end;
    gap: var(--space-4);
    margin-top: -56px;
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }
  .avatar {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--bg);
    background: var(--surface-3);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
  }
  .avatar-fallback {
    display: grid;
    place-items: center;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 3rem;
  }
  .pf-id {
    flex: 1;
    min-width: 0;
    padding-bottom: var(--space-1);
  }
  .pf-id h1 {
    font-size: var(--fs-3xl);
    line-height: 1;
  }
  .handle {
    color: var(--text-muted);
    font-size: var(--fs-base);
    margin-top: 2px;
  }
  .pf-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-3);
    font-size: var(--fs-sm);
    color: var(--text-dim);
  }
  .pf-stats strong {
    color: var(--text);
    font-weight: 600;
  }
  .pf-edit {
    margin-bottom: var(--space-1);
  }

  .pf-configs {
    padding-bottom: var(--space-10);
  }
  .pf-configs h2 {
    font-size: var(--fs-xl);
    margin-bottom: var(--space-4);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(268px, 1fr));
    gap: var(--space-4);
  }
  .empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-8) 0;
    color: var(--text-muted);
  }

  .notfound {
    max-width: 640px;
    padding-block: var(--space-10);
  }
  .notfound h1 {
    font-size: var(--fs-2xl);
  }
  .notfound p {
    margin: var(--space-3) 0 var(--space-5);
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .cover {
      height: 170px;
    }
    .pf-head {
      margin-top: -44px;
    }
    .avatar {
      width: 88px;
      height: 88px;
    }
  }
</style>
