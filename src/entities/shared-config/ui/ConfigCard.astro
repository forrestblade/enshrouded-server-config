---
/**
 * ConfigCard — a published config in a list (browse gallery + profiles).
 * Pure SSR, no client JS. Imported directly by path (not via the entity barrel).
 */
import type { ConfigListItem } from '@/entities/shared-config'

interface Props {
  config: ConfigListItem
}

const { config } = Astro.props
const authorName = config.author.displayUsername || config.author.username || 'Unknown'
const authorHref = config.author.username ? `/u/${config.author.username}` : null
---

<article class="card">
  <a class="card-main" href={`/c/${config.slug}`}>
    <div class="card-top">
      <span class="preset">{config.gameSettingsPreset}</span>
      <span class="metric" title={`${config.likeCount} likes`}>
        <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.6-10-9.3C.3 8.4 2 5 5.3 5c2 0 3.4 1.2 4.2 2.4C10.3 6.2 11.7 5 13.7 5 17 5 18.7 8.4 17 11.7 14.5 16.4 12 21 12 21z"/></svg>
        {config.likeCount}
      </span>
    </div>
    <h3 class="card-title">{config.title}</h3>
    <p class="card-server">{config.serverName}</p>
    {config.summary && <p class="card-summary">{config.summary}</p>}
    {config.tags.length > 0 && (
      <ul class="card-tags">
        {config.tags.slice(0, 4).map((t) => <li>{t}</li>)}
      </ul>
    )}
  </a>
  <footer class="card-foot">
    {authorHref
      ? (
        <a class="author" href={authorHref}>
          {config.author.image
            ? <img class="author-av" src={config.author.image} alt="" width="20" height="20" referrerpolicy="no-referrer" />
            : <span class="author-av author-av-fallback" aria-hidden="true">{authorName.charAt(0).toUpperCase()}</span>}
          <span>{authorName}</span>
        </a>
      )
      : <span class="author"><span class="author-av author-av-fallback" aria-hidden="true">?</span><span>{authorName}</span></span>}
  </footer>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover {
    border-color: var(--border-2);
    transform: translateY(-2px);
  }
  .card-main {
    display: block;
    padding: var(--space-4);
    color: inherit;
    text-decoration: none;
    flex: 1;
  }
  .card-main:hover {
    text-decoration: none;
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }
  .preset {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
  }
  .metric {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--fs-xs);
    color: var(--text-dim);
  }
  .card-title {
    font-size: var(--fs-lg);
    color: var(--text);
    line-height: 1.2;
  }
  .card-server {
    margin-top: 2px;
    font-size: var(--fs-xs);
    color: var(--text-dim);
    font-family: var(--font-mono);
  }
  .card-summary {
    margin-top: var(--space-2);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: var(--space-3);
    padding: 0;
  }
  .card-tags li {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 1px 8px;
  }
  .card-foot {
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--border);
  }
  .author {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-decoration: none;
  }
  .author:hover {
    color: var(--text);
    text-decoration: none;
  }
  .author-av {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    object-fit: cover;
  }
  .author-av-fallback {
    display: grid;
    place-items: center;
    background: var(--surface-3);
    color: var(--accent);
    font-size: 0.6rem;
    font-family: var(--font-display);
  }
</style>
