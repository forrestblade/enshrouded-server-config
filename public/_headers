# Cloudflare Pages headers — STATIC ASSETS ONLY. Pages does not apply this file
# to Functions (SSR) responses; those headers are set in src/middleware.ts.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/backgrounds/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/icons/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/favicon.svg
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
