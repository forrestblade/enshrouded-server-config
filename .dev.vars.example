# Copy to `.dev.vars` for local dev (loaded by Wrangler / the Cloudflare Vite plugin).
# In production these are set as Cloudflare Pages secrets — never commit real values.

# Better Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:4321"

# OAuth providers (create apps + set redirect to {BETTER_AUTH_URL}/api/auth/callback/<provider>)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# Auth is OAuth-only (no magic link / transactional email) — no email provider needed.

# Cloudflare Turnstile (bot gating on write endpoints)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Analytics — consent-gated Google Tag Manager + GA4 (loaded ONLY after consent).
# GTM is the tag manager; GA4 can live INSIDE the container OR be loaded directly.
# Configure GA4 in exactly ONE place — setting both a container that contains GA4
# and the direct measurement id double-counts every hit. These are PUBLIC (they
# ship to the browser), not secrets. GA4 owns reporting; there is no custom
# dashboard. Full setup: docs/TRACKING_SPEC.md.
PUBLIC_GTM_CONTAINER_ID="GTM-5H9R96VX"
PUBLIC_GA4_MEASUREMENT_ID="G-3PJG33PRF6"
