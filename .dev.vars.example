# Copy to `.dev.vars` for local dev (loaded by Wrangler / the Cloudflare Vite plugin).
# In production these are set as Cloudflare Pages secrets — never commit real values.

# Better Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:4321"

# OAuth providers (create apps + set redirect to {BETTER_AUTH_URL}/api/auth/callback/<provider>)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# Auth is OAuth-only (no magic link / transactional email) — no email provider needed.

# Analytics — consent-gated Google Tag Manager + GA4 (loaded ONLY after consent).
# These are PUBLIC values (they ship to the browser), not secrets — but use YOUR
# OWN ids; the placeholders below are intentionally invalid.
# page_view must be configured in exactly ONE place (see docs/TRACKING_SPEC.md §5):
#   Setup A — GA4 lives inside the GTM container: set the GTM id, leave GA4 "".
#   Setup B — direct GA4 for page_view + GTM for custom events only: set both.
PUBLIC_GTM_CONTAINER_ID="GTM-XXXXXXXX"
PUBLIC_GA4_MEASUREMENT_ID=""
